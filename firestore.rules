rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and family member records
    match /users/{userId} {
      // Only authenticated users can read or write their own user profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Strict privacy: family members and health details are accessible ONLY by the owner
      match /family_members/{memberId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Impact actions logged by user
      match /impact_actions/{actionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
